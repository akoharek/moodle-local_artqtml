# Copy to .env (gitignored) for local Docker dev. Never commit real keys.
#
# Seed into Moodle:
#   source .env
#   docker compose -f base.yml -f db.mariadb.yml -f webserver.port.yml exec \
#     -e ARTQTML_CLAUDE_API_KEY -e ARTQTML_GEMINI_API_KEY webserver \
#     php local/artqtml/tools/seed_dev_api_keys.php
#
ARTQTML_CLAUDE_API_KEY=
ARTQTML_GEMINI_API_KEY=
