# Browser / local test leftovers (never part of the plugin package).
/screens/
/node_modules/

# OS and editor junk.
**/.DS_Store

# Office lock / owner files while a document is open.
**/~$*
.~lock.*#

# Marketing assets (not referenced by the plugin; keep out of history).
/assets/

# Private keys / stray signed blobs.
*.pem

# Local scratch notes.
/result.md

# Generated by Moodle on every PHPUnit init — do not commit.
/phpunit.xml

# Local gate / cron run output and PHPUnit init stamp.
/tools/.gates-last.txt
/tools/.phpunit-initialised-at
/tools/.cron-last.txt

# Composer vendor for the local/CI PHPStan toolchain (tools/devtools).
# Manifest is tracked; packages install on demand (see tools/TOOLCHAIN.md).
/tools/devtools/vendor/
/tools/devtools/composer.lock

# Machine-local Claude Code permissions (shared .claude/skills/ stay tracked).
/.claude/settings.local.json

# Built Marketplace ZIPs (current local_artqtml-<version>.zip in dist/ root;
# previous in dist/old/). No unprefixed artqtml.zip alias.
/dist/

# Local one-off audit helpers (not shipped, not for public review).
.devtools/
/tools/.local-ci-last.txt
/tools/.mpc/
