<?xml version="1.0"?>
<ruleset name="local_artqtml">
    <description>Moodle coding standard for local_artqtml.</description>

    <rule ref="moodle"/>

    <arg name="extensions" value="php"/>
    <!-- Warnings fail the build (no ignore_warnings_on_exit). -->

    <exclude-pattern>*/tools/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
